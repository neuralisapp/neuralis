# ── Neuralis Community Edition ──────────────────────────────────
# Minimal .env — only environment-specific variables.
#
# Runtime settings live in: ~/.neuralis/app/config/platform.json (Admin UI)
# Secrets (API keys) live in: ~/.neuralis/app/credentials/ (encrypted, Admin UI)
#
# Run `pnpm setup` to generate this file + credentials + config.
# ════════════════════════════════════════════════════════════════

# ── Master Secret (REQUIRED) ─────────────────────────────────
# Used for NextAuth session encryption.
# Credential encryption uses a separate key in ~/.neuralis/app/config/credential-master.key.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── URLs & Ports ──────────────────────────────────────────────
# NEXTAUTH_URL and APP_URL must name the origin USERS ACTUALLY REACH. The
# localhost values below only work when the browser is on the same machine:
# reached over a LAN IP or a domain, a stale localhost value sends the browser
# to its own machine right after login. Set both (and MCP_BASE_URL) to the
# public origin for any non-localhost deployment.
NEXTAUTH_URL=http://localhost:3100
APP_URL=http://localhost:3100
MCP_BASE_URL=http://localhost:3101
NEURALIS_APP_PORT=3100
MCP_HTTP_PORT=3101
# Reverse proxies (addresses / CIDR) whose X-Forwarded-For the login lockout and the webhook cap believe.
# Empty = trust no forwarding header, only the connecting socket.
NEURALIS_TRUSTED_PROXIES=

# ── Storage ───────────────────────────────────────────────────
# Default: ~/.neuralis (auto-detected per platform).
# Docker: overridden by docker-compose.yml.
# NEURALIS_HOME=~/.neuralis

# ── Infrastructure Services ──────────────────────────────────
QDRANT_URL=http://localhost:6333
# Qdrant API key — every Qdrant request must carry it. Setup writes this line
# itself in docker/binary modes (minted once, preserved on re-runs) and asks in
# external mode (leave unset only for an external, unauthenticated server).
# Boot-critical infra, so it lives here and NOT in the credential store: the
# Qdrant client is constructed synchronously at boot, before any credential can
# be decrypted; the compose file hands it to the server via ${QDRANT_API_KEY:?}.
# QDRANT_API_KEY=
# Qdrant web dashboard (static SPA at 127.0.0.1:6333/dashboard). Set 'off' to
# disable it, then: pnpm neuralis:setup --compose-only && docker compose up -d
QDRANT_DASHBOARD=on
# Qdrant log level (ERROR | WARN | INFO | DEBUG | TRACE). Default: INFO.
# Docker: propagates to container as QDRANT__LOG_LEVEL.
QDRANT_LOG_LEVEL=INFO
OLLAMA_URL=http://localhost:11434
BRAIN_INFRA_MODE=local

# ── Docker (set automatically by docker-compose) ─────────────
# LOCAL_UID=1000
# LOCAL_GID=1000
# DOCKER_GID — host GID that owns /var/run/docker.sock. Added as a
# supplementary group so machine-core can talk to the socket. Detect with:
#   stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999

# ── Admin Bootstrap ──────────────────────────────────────────
# Lock first-user registration to a specific email (optional).
# NEURALIS_ADMIN_EMAIL=admin@example.com

# ── Machine-core (per-user Webtop + Selkies + Playwright-over-CDP) ──
# LinuxServer Webtop container streamed into the workspace over pure
# HTTP/WS (no UDP ports to publish). One container per (projectId, userId)
# by default.
#
# Path to the Docker socket used by MachineSessionManager to spawn per-user
# Webtop containers. Default is the standard Linux location; in docker-compose
# the host socket is bind-mounted here.
NEURALIS_MACHINE_DOCKER_SOCKET=/var/run/docker.sock

# Webtop image — MUST be a pinned digest in production. `neuralisapp/webtop-…`
# is the machine-core derivative image (Session 2 builds it with Chromium's
# remote-debugging flags baked in + the sidecar service).
NEURALIS_MACHINE_IMAGE=neuralisapp/webtop-ubuntu-xfce:dev

# Container scope. `user` mode pairs a container with (projectId, userId),
# the default — each user gets an independent persistent desktop.
# `project` mode is one container per project, shared by members.
NEURALIS_MACHINE_CONTAINER_SCOPE=user

# Idle minutes before SessionReaper stops a machine container. Sessions
# auto-resume on next widget open.
NEURALIS_MACHINE_IDLE_MINUTES=30

# Desktop geometry inside the Webtop container (width x height).
NEURALIS_MACHINE_SCREEN=1920x1080

# The first beta bundles Ubuntu + XFCE. A compatible custom Neuralis desktop
# image may use its own variant identifier alongside NEURALIS_MACHINE_IMAGE.
NEURALIS_MACHINE_DESKTOP_VARIANT=ubuntu-xfce

# Port the machine-core sidecar service listens on inside the container
# (the host HTTP client hits http://<container>:<port> via the shared docker
# network). Keep in sync with the derivative image's s6 service file.
NEURALIS_MACHINE_SIDECAR_PORT=9400

# Chromium CDP port inside the container. Session 2 bakes this into the
# Chromium s6 service file (--remote-debugging-port=<port>).
NEURALIS_MACHINE_CDP_PORT=9222

# Set true to relax the Docker seccomp profile on machine containers.
# Required on WSL2 and some container runtimes where Chromium's sandbox
# syscalls get blocked by the default profile (symptom: Chromium SIGTRAP
# crash-loop). Production Linux hosts usually don't need this.
NEURALIS_MACHINE_SECCOMP_UNCONFINED=false

# (Optional) Override which docker network machine containers join. Auto-
# detected from the neuralis container's own networks when running inside
# docker-compose; only set this if auto-detect fails.
# NEURALIS_MACHINE_SHARED_NETWORK=neuralis_default

# (Optional) Host address used when neuralis is NOT running in docker
# (dev on Linux/Mac native). Defaults to 'localhost'.
# NEURALIS_MACHINE_HOST_ADDRESS=localhost
