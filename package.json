{
  "name": "neuralis",
  "version": "0.4.0",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://neuralisapp.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuralisapp/neuralis.git"
  },
  "bugs": {
    "url": "https://github.com/neuralisapp/neuralis/issues"
  },
  "keywords": [
    "neuralis",
    "self-hosted",
    "ai-agents",
    "multi-agent",
    "ai-workspace",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "llm",
    "docker"
  ],
  "engines": { "node": ">=26" },
  "devEngines": { "runtime": { "name": "node", "version": ">=26", "onFail": "error" } },
  "bin": { "neuralis": "bin/neuralis.mjs" },
  "files": [
    "bin",
    "src",
    "scripts",
    "skills",
    "public",
    "docker",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "tsconfig.scripts.json",
    "vitest.config.mts",
    "Dockerfile",
    ".env.example",
    "SECURITY.md",
    "DOCKERHUB.md",
    "maturity.json"
  ],
  "scripts": {
    "prepack": "node scripts/build/assert-no-machine-local-deps.mjs",
    "dev": "next dev --turbopack -p 3100",
    "dev:mcp-standalone": "tsx scripts/mcp-http.ts",
    "build": "next build && node scripts/build/check-server-chunk-split-brain.mjs",
    "start": "next start -p 3100 --keepAliveTimeout 55000",
    "start:mcp": "node --import tsx scripts/mcp-http.ts",
    "neuralis:setup": "node --import tsx scripts/cli/registry.mts setup",
    "neuralis:rebuild": "node --import tsx scripts/cli/registry.mts rebuild",
    "neuralis:sync": "node --import tsx scripts/cli/registry.mts sync",
    "neuralis:update": "node --import tsx scripts/cli/registry.mts update",
    "neuralis:mount": "node --import tsx scripts/cli/registry.mts mount",
    "neuralis:pkg": "node --import tsx scripts/cli/registry.mts pkg",
    "neuralis:user": "node --import tsx scripts/cli/registry.mts user",
    "neuralis:checkpoint": "node --import tsx scripts/cli/registry.mts checkpoint",
    "neuralis:backup": "node --import tsx scripts/cli/registry.mts backup",
    "neuralis:restore": "node --import tsx scripts/cli/registry.mts restore",
    "neuralis:upgrade": "node --import tsx scripts/cli/registry.mts upgrade",
    "release:audit": "node scripts/build/audit-publish-tarballs.mjs",
    "release:rehearse": "node scripts/build/channel1-rehearsal.mjs",
    "release:version": "node --import tsx scripts/release-version.mts",
    "reset:vector": "node --import tsx scripts/cli/registry.mts reset-vector",
    "neuralis:qdrant-upgrade": "node --import tsx scripts/cli/registry.mts qdrant-upgrade",
    "neuralis:start": "node --import tsx scripts/cli/registry.mts start",
    "neuralis:tunnel": "node --import tsx scripts/cli/registry.mts tunnel",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neuralis/admin": "0.4.0",
    "@neuralis/agent-core": "0.4.0",
    "@neuralis/brain-core": "0.4.0",
    "@neuralis/machine-core": "0.4.0",
    "@neuralis/package-system": "0.4.0",
    "@tailwindcss/oxide": "4.3.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dockerode": "^5.0.1",
    "express": "^5.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.15.3",
    "react-rnd": "^10.5.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "express-rate-limit": "^8.2.2",
    "hono": "^4.13.5",
    "@hono/node-server": "^1.19.15 || ^2.0.5",
    "ip-address": "^10.7.4",
    "fast-uri": "^3.1.9",
    "@qdrant/js-client-rest": {
      "undici": "^7.30.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.3"
    }
  },
  "allowScripts": {
    "@neuralis/agent-core": true,
    "node-pty": true,
    "esbuild": false,
    "sharp": false,
    "ssh2": false,
    "cpu-features": false,
    "protobufjs": false,
    "@google/genai": false,
    "electron": true,
    "electron-winstaller": false
  }
}
