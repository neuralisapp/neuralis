/**
 * The `credential-key-v2` upgrade's dry run is the check that replaced the
 * credential store's NEXTAUTH_SECRET / static-salt fallback: every blob must
 * open under the key file + salt file, and one that does not is NAMED, with the
 * retired key that still opens it.
 */

import { afterEach, beforeEach, describe, expect, it } from 'vitest';
import { existsSync, mkdirSync, mkdtempSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { CredentialStore, deriveKey, encrypt } from '../../../src/server/store/CredentialStore';
import upgrade from '../credential-key-v2.mts';

let home: string;
let ctx: { home: string; appRoot: string; projectsRoot: string; log: (line: string) => void };
const priorSecret = process.env.NEXTAUTH_SECRET;

beforeEach(() => {
  home = mkdtempSync(join(tmpdir(), 'nrs-credential-key-'));
  ctx = { home, appRoot: join(home, 'app'), projectsRoot: join(home, 'projects'), log: () => {} };
  mkdirSync(join(ctx.appRoot, 'config'), { recursive: true });
  process.env.NEXTAUTH_SECRET = 'legacy-nextauth-secret';
});

afterEach(() => {
  rmSync(home, { recursive: true, force: true });
  if (priorSecret === undefined) delete process.env.NEXTAUTH_SECRET;
  else process.env.NEXTAUTH_SECRET = priorSecret;
});

const store = () => new CredentialStore(ctx.appRoot, join(ctx.appRoot, 'config'));

/** A blob exactly as the retired fallback wrote it: NEXTAUTH_SECRET bytes + the static salt. */
async function writeRetired(scopeDir: string, scope: string, id: string): Promise<void> {
  const key = await deriveKey(Buffer.from('legacy-nextauth-secret', 'utf-8'), Buffer.from('neuralis-credential-v1', 'utf-8'), scope);
  mkdirSync(join(ctx.appRoot, 'credentials', scopeDir), { recursive: true });
  writeFileSync(join(ctx.appRoot, 'credentials', scopeDir, `${id}.enc.json`), JSON.stringify(encrypt('secret', key)));
}

describe('credential-key-v2 — every blob opens under the key file', () => {
  it('raises the credential kind to the version the host declares, offline', () => {
    expect(upgrade.id).toBe('credential-key-v2');
    expect(upgrade.kinds).toEqual([{ kind: 'neuralis/credential', to: 2 }]);
  });

  it('PAIRED CONTROL — blobs the store wrote under its key + salt files: no blocker, nothing written, the apply passes', async () => {
    await store().writeGlobal('llm.x', 'a');
    await store().writeAgent('p1', 'coder', 'git.token', 'b');
    const before = readdirSync(join(ctx.appRoot, 'config')).sort();
    const plan = await upgrade.dryRun(ctx);
    expect(plan.blockers).toBeUndefined();
    expect(plan.files).toEqual([]);
    expect(plan.summary).toEqual(['credentials: 2 of 2 open under the key file']);
    expect(readdirSync(join(ctx.appRoot, 'config')).sort()).toEqual(before);
    await expect(upgrade.apply(ctx)).resolves.toBeUndefined();
  });

  it('RED-FIRST: a blob only NEXTAUTH_SECRET opens is named, and the apply refuses', async () => {
    await store().writeGlobal('llm.x', 'a');
    await writeRetired('projects/p1', 'p1', 'llm.y');
    const plan = await upgrade.dryRun(ctx);
    expect(plan.blockers?.lines).toEqual(['credentials/projects/p1/llm.y.enc.json · opens only under NEXTAUTH_SECRET (written while credential-master.key was missing)']);
    expect(plan.blockers?.remedy).toContain('credential-master.key');
    await expect(upgrade.apply(ctx)).rejects.toThrow(/1 credential\(s\) do not open under the key file/);
  });

  it('a missing key file is named and NOT generated by the dry run; a bare-slug agent blob is named', async () => {
    await writeRetired('global', '_global', 'llm.x');
    mkdirSync(join(ctx.appRoot, 'credentials', 'agents', 'coder'), { recursive: true });
    writeFileSync(join(ctx.appRoot, 'credentials', 'agents', 'coder', 'git.token.enc.json'), '{}');
    const plan = await upgrade.dryRun(ctx);
    expect(plan.blockers?.lines).toEqual([
      'credentials/agents/coder/git.token.enc.json · retired bare-slug agent layout — no scope opens it',
      'app/config/credential-master.key · missing beside 1 encrypted credential(s)',
      'app/config/credential-salt.bin · missing beside 1 encrypted credential(s)',
      'credentials/global/llm.x.enc.json · opens only under NEXTAUTH_SECRET (written while credential-master.key was missing)',
    ]);
    expect(existsSync(join(ctx.appRoot, 'config', 'credential-master.key'))).toBe(false);
    expect(existsSync(join(ctx.appRoot, 'config', 'credential-salt.bin'))).toBe(false);
  });

  it('an install with no credential at all has nothing to check', async () => {
    const plan = await upgrade.dryRun(ctx);
    expect(plan).toEqual({ files: [], summary: ['credentials: none stored'] });
  });
});
