import { spawnSync } from 'node:child_process';
import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { afterAll, describe, expect, it } from 'vitest';

/**
 * `pnpm neuralis:mount add <dir> --pkg <name>` — the "not discovered until
 * registered" warning appears only for a package the host does NOT depend on.
 * Hermetic like pkgCli: the CLI runs from a COPY of `scripts/` under a mkdtemp
 * host folder, so the real override and host manifest are never opened.
 */

const realHost = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
const sandbox = mkdtempSync(join(tmpdir(), 'neuralis-mount-cli-'));
const host = join(sandbox, 'host');

mkdirSync(host, { recursive: true });
cpSync(join(realHost, 'scripts'), join(host, 'scripts'), { recursive: true });
symlinkSync(join(realHost, 'node_modules'), join(host, 'node_modules'), 'dir');
// mount.mts reaches a few host `src/` helpers through the setup modules — read-only.
symlinkSync(join(realHost, 'src'), join(host, 'src'), 'dir');

afterAll(() => rmSync(sandbox, { recursive: true, force: true }));

function mountAddPkg(name: string, dependencies: Record<string, string>): string {
  writeFileSync(join(host, 'package.json'), JSON.stringify({ name: 'neuralis', bin: { neuralis: 'bin/neuralis.mjs' }, dependencies }));
  rmSync(join(host, 'docker-compose.override.yml'), { force: true });
  const dir = join(sandbox, 'src', name.replace(/[@/]/g, '_'));
  mkdirSync(dir, { recursive: true });
  writeFileSync(join(dir, 'package.json'), JSON.stringify({ name }));
  const res = spawnSync(process.execPath, ['--import', 'tsx', join(host, 'scripts', 'cli', 'registry.mts'), 'mount', 'add', dir, '--pkg', name], {
    cwd: host,
    encoding: 'utf8',
    env: { ...process.env, NEURALIS_HOME: join(sandbox, 'home') },
  });
  expect(existsSync(join(host, 'docker-compose.override.yml')), `${res.stdout}${res.stderr}`).toBe(true);
  return `${res.stdout}${res.stderr}`;
}

describe('mount add --pkg — the registration warning', () => {
  it('says the package loads from the folder when the host already depends on it', () => {
    const out = mountAddPkg('@acme/bound', { '@acme/bound': 'file:/x' });
    expect(out).toContain('is a host dependency');
    expect(out).not.toContain('NOT discovered');
  });

  it('control: warns when the package is not a host dependency', () => {
    const out = mountAddPkg('@acme/loose', {});
    expect(out).toContain('NOT discovered');
  });
});

describe('mount on an image-only folder (inside its one-shot container)', () => {
  const folder = join(sandbox, 'image-folder');
  mkdirSync(folder, { recursive: true });
  writeFileSync(join(folder, 'docker-compose.yml'), '# GENERATED by neuralis setup (2026-10-19, neuralis 0.3.2) — do not hand-edit.\nname: neuralis\n');
  writeFileSync(join(folder, '.env'), 'NEURALIS_IMAGE_TAG=0.3.2\n');
  const bin = join(sandbox, 'fake-bin');
  mkdirSync(bin, { recursive: true });
  writeFileSync(join(bin, 'docker'), '#!/bin/sh\nprintf \'%s\\n\' "$*" >> "$FAKE_LOG"\nexit "${FAKE_CODE:-0}"\n', { mode: 0o755 });

  function mount(args: string[], code = '0'): { status: number | null; out: string; calls: string[] } {
    const log = join(sandbox, `docker-${Math.random().toString(36).slice(2)}.log`);
    writeFileSync(log, '');
    // `--import` resolves from the working directory, and the folder has no node_modules: name tsx's loader.
    const res = spawnSync(process.execPath, ['--import', pathToFileURL(join(realHost, 'node_modules', 'tsx', 'dist', 'loader.mjs')).href, join(host, 'scripts', 'cli', 'registry.mts'), 'mount', ...args], {
      cwd: folder,
      encoding: 'utf8',
      env: { ...process.env, PATH: `${bin}:${process.env.PATH ?? ''}`, NEURALIS_DOCKER: 'true', NEURALIS_HOME: join(sandbox, 'home'), FAKE_LOG: log, FAKE_CODE: code },
    });
    return { status: res.status, out: `${res.stdout}${res.stderr}`, calls: readFileSync(log, 'utf8').trim().split('\n').filter(Boolean) };
  }

  it('--pkg and --neuralis refuse by name; a bare add asks for the host path instead of browsing the container', () => {
    expect(mount(['add', '/srv/x', '--pkg', '@acme/x']).out).toContain('--pkg does not apply to an image-only install folder');
    expect(mount(['add', '/srv/x', '--neuralis']).out).toContain('--neuralis does not apply to an image-only install folder');
    expect(mount(['add']).out).toContain('Name the host folder');
  });

  it('the HOST path is checked by the daemon (a read-only bind into the folder\'s own image), never by this container', () => {
    const missing = mount(['add', '/srv/does-not-exist-here'], '125');
    expect(missing.status).toBe(1);
    expect(missing.out).toContain('does not exist on the host');
    expect(missing.calls[0]).toBe('run --rm --mount type=bind,"source=/srv/does-not-exist-here",target=/probe,readonly neuralisapp/neuralis:0.3.2 test -d /probe');
    expect(existsSync(join(folder, 'docker-compose.override.yml'))).toBe(false);
    // PAIRED CONTROL: the daemon binds it — the override is written although this process cannot see the path.
    const bound = mount(['add', '/srv/does-not-exist-here']);
    expect(bound.status, bound.out).toBe(0);
    expect(readFileSync(join(folder, 'docker-compose.override.yml'), 'utf8')).toContain('/srv/does-not-exist-here:/mounts/does-not-exist-here');
  });
});
