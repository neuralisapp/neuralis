// The fake `docker` is a POSIX shell script: on Windows it would not run and the real Docker would answer (not covered there).
describe.skipIf(process.platform === 'win32')('update on an image-only folder: the image is the code', () => {
  /** A fake `docker` on PATH: logs every call; `image inspect` answers FAKE_PRESENT; `run` records whether its --manifest file exists. */
  const FAKE_DOCKER = `#!/bin/sh
printf '%s\\n' "$*" >> "$FAKE_LOG"
case "$1" in
  image) [ -n "$FAKE_PRESENT" ] && exit 0; exit 1 ;;
  pull) exit "\${FAKE_PULL_CODE:-0}" ;;
  compose)
    case "$*" in
      *"config --format json"*) printf '%s' "$FAKE_MODEL" ;;
      *"ps --status running"*) printf '%s\\n' \${FAKE_RUNNING:-neuralis qdrant} | tr ' ' '\\n' ;;
      *" run --rm --no-deps -T "*) printf '%s' "$FAKE_UPGRADE_OUT" ;;
      *"ps --format"*) printf '%s\\n' "$FAKE_APP_IMAGE" ;;
      *" exec -T "*) printf '%s' "$FAKE_HEALTH"; exit "\${FAKE_EXEC_CODE:-0}" ;;
    esac
    exit 0 ;;
  run)
    prev=""; for a in "$@"; do if [ "$prev" = "--manifest" ] && [ -f "$a" ]; then echo "manifest-present" >> "$FAKE_LOG"; fi; prev="$a"; done
    exit "\${FAKE_RUN_CODE:-0}" ;;
esac
exit 0
`;
  const MODEL = JSON.stringify({ name: 'neuralis-x', services: { neuralis: { labels: { 'neuralis.kind': 'app' } }, qdrant: { labels: { 'neuralis.kind': 'vectorstore' } } } });

  /** Runs `fn` with the fake docker first on PATH and the FAKE_* env set; every key is put back after. */
  async function withFakeDocker<T>(env: Record<string, string>, fn: (log: () => string[]) => Promise<T>): Promise<T> {
    const bin = mkdtempSync(join(tmpdir(), 'neuralis-fake-docker-'));
    writeFileSync(join(bin, 'docker'), FAKE_DOCKER, { mode: 0o755 });
    const logFile = join(bin, 'calls.log');
    writeFileSync(logFile, '');
    const set = { PATH: `${bin}${delimiter}${process.env.PATH ?? ''}`, FAKE_LOG: logFile, FAKE_MODEL: MODEL, ...env };
    const before = Object.fromEntries(Object.keys(set).map((k) => [k, process.env[k]]));
    Object.assign(process.env, set);
    try {
      return await fn(() => readFileSync(logFile, 'utf-8').trim().split('\n').filter(Boolean));
    } finally {
      for (const [k, v] of Object.entries(before)) {
        if (v === undefined) delete process.env[k];
        else process.env[k] = v;
      }
    }
  }

  /** The update's context on the host: a socket file the Docker endpoint names, and a throwaway data home. */
  function imageContext(folder: string, code: string) {
    const home = mkdtempSync(join(tmpdir(), 'neuralis-image-home-'));
    const socket = join(home, 'docker.sock');
    writeFileSync(socket, '');
    return { ctx: cliContext({ installDir: folder, packageDir: code }, { DOCKER_HOST: `unix://${socket}`, NEURALIS_HOME: home }), home, socket };
  }

  const LINE = { schema: 1, version: '0.3.3', packages: { neuralis: '0.3.3' }, images: { 'neuralisapp/neuralis': '0.3.3' } };

  it('pulls the target only when it is absent, then re-runs the update in the TARGET image with the same mounts; the manifest sits in the folder for that run and is gone after', async () => {
    const folder = imageFolder('0.3.2');
    const manifest = join(mkdtempSync(join(tmpdir(), 'neuralis-line-')), 'line.json');
    writeFileSync(manifest, JSON.stringify(LINE));
    const { ctx, home, socket } = imageContext(folder, imageCode('0.3.2'));
    const log = vi.spyOn(console, 'log').mockImplementation(() => {});
    const homeBefore = process.env.NEURALIS_HOME;
    process.env.NEURALIS_HOME = home;
    try {
      // Absent locally: inspect, then pull, then the re-exec.
      const calls = await withFakeDocker({}, async (read) => {
        expect(await runUpdateVerb(['--manifest', manifest, '--apply'], ctx)).toBe(0);
        return read();
      });
      const inspect = calls.findIndex((c) => c.startsWith('image inspect'));
      const pull = calls.indexOf('pull neuralisapp/neuralis:0.3.3');
      const reexec = calls.findIndex((c) => c.startsWith('run '));
      expect(inspect).toBeGreaterThanOrEqual(0);
      expect(pull).toBeGreaterThan(inspect);
      expect(reexec).toBeGreaterThan(pull);
      const run = calls[reexec]!;
      for (const part of [
        `--user ${process.getuid!()}:${process.getgid!()}`,
        `-v ${socket}:/var/run/docker.sock --group-add `,
        `-v ${home}:/.neuralis -e NEURALIS_HOST_HOME=${home}`,
        `-v ${folder}:${folder} -w ${folder}`,
        `-e NEURALIS_HOST_DOCKER_SOCKET=${socket}`,
        '-e NEURALIS_UPDATE_PREVIOUS=0.3.2',
        `neuralisapp/neuralis:0.3.3 node /neuralis/bin/neuralis.mjs update --apply --host-swapped --manifest ${folder}/.neuralis-update-`,
      ]) expect(run).toContain(part);
      expect(calls[reexec + 1]).toBe('manifest-present');
      expect(readdirSync(folder).filter((n) => n.startsWith('.neuralis-update-'))).toEqual([]);
      // Nothing moved in THIS process: the target image's run moves the tag.
      expect(readFileSync(join(folder, '.env'), 'utf-8')).toContain('NEURALIS_IMAGE_TAG=0.3.2\n');

      // Present locally: no pull (a version tag never changes).
      const present = await withFakeDocker({ FAKE_PRESENT: '1' }, async (read) => {
        expect(await runUpdateVerb(['--manifest', manifest, '--apply'], ctx)).toBe(0);
        return read();
      });
      expect(present.some((c) => c.startsWith('pull'))).toBe(false);
      expect(present.some((c) => c.startsWith('run '))).toBe(true);
    } finally {
      log.mockRestore();
      if (homeBefore === undefined) delete process.env.NEURALIS_HOME;
      else process.env.NEURALIS_HOME = homeBefore;
    }
  });

  it('a move DOWN to a release that predates the image kind runs the steps in this code, with that release\'s own-tree compose regeneration; the record is written', async () => {
    const folder = imageFolder('0.3.3');
