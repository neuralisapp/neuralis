    const logged: string[] = [];
    const log = vi.spyOn(console, 'log').mockImplementation((...args: unknown[]) => { logged.push(args.join(' ')); });
    const homeBefore = process.env.NEURALIS_HOME;
    process.env.NEURALIS_HOME = home;
    try {
      // The resumed stack runs (and stops at its compose step: this fixture's code has no setup to run).
      await withFakeDocker({ FAKE_PRESENT: '1' }, async () => { expect(await runUpdateVerb(['--version', '0.3.3', '--apply'], ctx)).toBe(1); });
      let out = logged.join('\n').replace(/\x1b\[[0-9;]*m/g, '');
      expect(out).toContain('.env is on 0.3.3, the compose file pins 0.3.2 — the stack steps run again (an earlier update may have stopped mid-stack).');
      expect(out).toContain('stopped at compose');
      expect(out).not.toContain('already on');
      // PAIRED CONTROL: a compose file on the same tag is "already on", and nothing runs.
      logged.length = 0;
      writeFileSync(join(folder, 'docker-compose.yml'), '# GENERATED by neuralis setup (2026-10-19, neuralis 0.3.3) — do not hand-edit.\nservices:\n  neuralis:\n    image: neuralisapp/neuralis:0.3.3\n');
      const calls = await withFakeDocker({ FAKE_PRESENT: '1', FAKE_APP_IMAGE: 'neuralisapp/neuralis:0.3.3' }, async (read) => { expect(await runUpdateVerb(['--version', '0.3.3', '--apply'], ctx)).toBe(0); return read(); });
      out = logged.join('\n').replace(/\x1b\[[0-9;]*m/g, '');
      expect(out).toContain('already on 0.3.3.');
      expect(calls.some((c) => /^(image|pull|run) /.test(c))).toBe(false);
      // A stop AFTER the regeneration: .env and the compose file agree, the running container is still the old release.
      logged.length = 0;
      await withFakeDocker({ FAKE_PRESENT: '1', FAKE_APP_IMAGE: 'neuralisapp/neuralis:0.3.2' }, async () => { expect(await runUpdateVerb(['--version', '0.3.3', '--apply'], ctx)).toBe(1); });
      out = logged.join('\n').replace(/\x1b\[[0-9;]*m/g, '');
      expect(out).toContain('.env is on 0.3.3, the app container runs 0.3.2 — the stack steps run again (an earlier update may have stopped mid-stack).');
      expect(out).not.toContain('already on');
      // An app that is not running resumes too (the stack runs the release after --apply) …
      logged.length = 0;
      await withFakeDocker({ FAKE_PRESENT: '1', FAKE_RUNNING: 'qdrant' }, async () => { expect(await runUpdateVerb(['--version', '0.3.3', '--apply'], ctx)).toBe(1); });
      out = logged.join('\n').replace(/\x1b\[[0-9;]*m/g, '');
      expect(out).toContain('.env is on 0.3.3, the app is not running — the stack steps run again');
      // … while a Docker that cannot name the running image is no evidence: "already on".
      logged.length = 0;
      await withFakeDocker({ FAKE_PRESENT: '1' }, async () => { expect(await runUpdateVerb(['--version', '0.3.3', '--apply'], ctx)).toBe(0); });
      out = logged.join('\n').replace(/\x1b\[[0-9;]*m/g, '');
      expect(out).toContain('already on 0.3.3.');
    } finally {
      log.mockRestore();
      if (homeBefore === undefined) delete process.env.NEURALIS_HOME;
      else process.env.NEURALIS_HOME = homeBefore;
    }
  });

  it('a failed pull moves nothing: no re-exec, the .env tag stays', async () => {
    const folder = imageFolder('0.3.2');
    const { ctx } = imageContext(folder, imageCode('0.3.2'));
    const log = vi.spyOn(console, 'log').mockImplementation(() => {});
    try {
      const calls = await withFakeDocker({ FAKE_PULL_CODE: '1' }, async (read) => {
        await expect(runUpdateVerb(['--version', '0.3.3', '--apply'], ctx)).rejects.toThrow(/docker pull neuralisapp\/neuralis:0\.3\.3 failed/);
        return read();
      });
      expect(calls.some((c) => c.startsWith('run '))).toBe(false);
      expect(readFileSync(join(folder, '.env'), 'utf-8')).toContain('NEURALIS_IMAGE_TAG=0.3.2\n');
    } finally {
      log.mockRestore();
    }
  });

  it('the dry run names the image-only folder, its one row and the stack; nothing is pulled', async () => {
    const folder = imageFolder('0.3.2');
    const { ctx } = imageContext(folder, imageCode('0.3.2'));
    const logged: string[] = [];
    const log = vi.spyOn(console, 'log').mockImplementation((...args: unknown[]) => { logged.push(args.join(' ')); });
    try {
      const calls = await withFakeDocker({}, async (read) => {
        expect(await runUpdateVerb(['--version', '0.3.3', '--json'], ctx)).toBe(0);
        return read();
      });
      expect(calls.some((c) => /^(image|pull|run) /.test(c))).toBe(false);
    } finally {
      log.mockRestore();
    }
    const json = JSON.parse(logged.join('\n')) as Record<string, unknown>;
    expect(json).toMatchObject({ layout: 'image', plan: [{ name: 'neuralisapp/neuralis', current: '0.3.2', target: '0.3.3', unchanged: false }], image: null, apply: false });
    expect(json.stack).toMatchObject({ folder, project: 'neuralis-x', app: 'neuralis', vectorstore: 'qdrant' });
  });

  it('the image health probe asks the app container itself through `compose exec`: the 503 body\'s code survives; a failed exec is "starting"', async () => {
    const target = { url: 'http://127.0.0.1:3100/api/health', cwd: mkdtempSync(join(tmpdir(), 'neuralis-health-')), project: 'neuralis-x', app: 'neuralis' };
    const answers = await withFakeDocker({ FAKE_HEALTH: '503 {"status":"error","code":"upgrade_required"}' }, async (read) => {
      const refused = await IMAGE_PORTS.health(target);
      return { refused, calls: read() };
    });
    expect(answers.refused).toEqual({ kind: 'refused', code: 'upgrade_required' });
    expect(answers.calls[0]).toMatch(/^compose -p neuralis-x exec -T neuralis node -e fetch\('http:\/\/127\.0\.0\.1:3100\/api\/health'/);
    expect(await withFakeDocker({ FAKE_HEALTH: '200 {"status":"ready"}' }, () => IMAGE_PORTS.health(target))).toEqual({ kind: 'ready' });
    expect(await withFakeDocker({ FAKE_HEALTH: '200 {"status":"degraded","health":"degraded"}' }, () => IMAGE_PORTS.health(target))).toEqual({ kind: 'ready', degraded: true });
    expect(await withFakeDocker({ FAKE_HEALTH: '503 {"status":"degraded","health":"failed"}' }, () => IMAGE_PORTS.health(target))).toEqual({ kind: 'starting', detail: 'HTTP 503 degraded' });
    expect(await withFakeDocker({ FAKE_HEALTH: '0 ECONNREFUSED' }, () => IMAGE_PORTS.health(target))).toEqual({ kind: 'starting', detail: 'ECONNREFUSED' });
    expect((await withFakeDocker({ FAKE_EXEC_CODE: '1' }, () => IMAGE_PORTS.health(target))).kind).toBe('starting');
  });
});
